#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
project_root="$(cd "$(dirname "${script_path}")/.." && pwd)"
export PYTHONNOUSERSITE=1

runtime_config="${project_root}/configs/runtime/openvla_piper.yaml"
rlds_config="${project_root}/configs/rlds/piper_bridge.yaml"
training_config="${project_root}/configs/training/openvla_lora.yaml"

runtime_python() {
  local runtime_prefix="${OPENVLA_CONDA_PREFIX:-}"
  if [[ -z "${runtime_prefix}" && -r "${project_root}/.install-prefix" ]]; then
    IFS= read -r runtime_prefix <"${project_root}/.install-prefix"
  fi
  [[ -n "${runtime_prefix}" && -x "${runtime_prefix}/bin/python" ]] || {
    printf '%s\n' 'error=runtime_environment_missing hint=run_scripts/install_openvla.sh' >&2
    exit 1
  }
  printf '%s' "${runtime_prefix}/bin/python"
}

rlds_python() {
  local rlds_prefix="${RLDS_TOOLS_PREFIX:-}"
  if [[ -z "${rlds_prefix}" && -r "${project_root}/.rlds-tools-prefix" ]]; then
    IFS= read -r rlds_prefix <"${project_root}/.rlds-tools-prefix"
  fi
  [[ -n "${rlds_prefix}" && -x "${rlds_prefix}/bin/python" ]] || {
    printf '%s\n' 'error=rlds_environment_missing hint=run_scripts/openvla-pipeline_install-rlds' >&2
    exit 1
  }
  printf '%s' "${rlds_prefix}/bin/python"
}

# The Python logger uses one bounded worker. Cap native pools before Python
# imports numerical libraries so launches cannot multiply conversion threads.
set_bounded_env() {
  local target_name="$1" override_name="$2" default_value="$3" max_value="$4"
  local override_value="${!override_name-}"
  local value="${override_value:-${default_value}}"
  if [[ ! "${value}" =~ ^[1-9][0-9]*$ ]] || (( value > max_value )); then
    printf 'error=invalid_env_limit name=%s value=%q allowed=1..%s\n' \
      "${override_name}" "${value}" "${max_value}" >&2
    exit 2
  fi
  printf -v "${target_name}" '%s' "${value}"
  export "${target_name}"
}
set_bounded_env OMP_NUM_THREADS OPENVLA_OMP_NUM_THREADS 4 8
set_bounded_env MKL_NUM_THREADS OPENVLA_MKL_NUM_THREADS 4 8
set_bounded_env OPENBLAS_NUM_THREADS OPENVLA_OPENBLAS_NUM_THREADS 4 8
set_bounded_env NUMEXPR_NUM_THREADS OPENVLA_NUMEXPR_NUM_THREADS 4 8
set_bounded_env TF_NUM_INTRAOP_THREADS OPENVLA_TF_NUM_INTRAOP_THREADS 1 4
set_bounded_env TF_NUM_INTEROP_THREADS OPENVLA_TF_NUM_INTEROP_THREADS 1 4
export TOKENIZERS_PARALLELISM="${TOKENIZERS_PARALLELISM:-false}"
export PIPER_OPENVLA_LOG_QUEUE_SIZE="${PIPER_OPENVLA_LOG_QUEUE_SIZE:-1024}"

usage() {
  cat <<'EOF'
usage: scripts/openvla-pipeline COMMAND [options]

commands:
  download-models download the pinned checkpoint and base model snapshots
  install-rlds   install isolated LeRobot-to-RLDS conversion dependencies
  convert-rlds   convert PiPER LeRobotDataset v3 episodes into TFDS/RLDS
  verify-rlds    verify raw RLDS and OpenVLA-OFT piper_bridge registration
  train-lora     run official OpenVLA-OFT synchronous LoRA fine-tuning
  show-config    print resolved YAML/environment settings
  plan          resolve launch settings without server, ROS, or GPU access
  model-server  merge LoRA and start the synchronous FastAPI model server
  probe          run one ROS-free image-pair request against FastAPI
  dry-run       sync inference; read observations, never publish robot actions
  run-robot     sync inference with the three-part physical safety gate
  smoke         run CPU-only synthetic contract tests

checkpoint source: --checkpoint /local/dir or hf://OWNER/REPO@REVISION
precedence: CLI > environment > YAML config
EOF
}

command="${1:-help}"
if (( $# > 0 )); then shift; fi
case "${command}" in
  download-models)
    exec "${project_root}/scripts/download_openvla_models.sh" "$@"
    ;;
  install-rlds)
    exec "${project_root}/scripts/install_rlds_tools.sh" "$@"
    ;;
  convert-rlds)
    cd "${project_root}"
    exec env \
      PYTHONNOUSERSITE=1 \
      HF_HOME="${project_root}/.runtime/huggingface-rlds" \
      HF_DATASETS_CACHE="${project_root}/.runtime/huggingface-rlds/datasets" \
      "$(rlds_python)" scripts/convert_lerobot_to_rlds.py \
      --config "${rlds_config}" "$@"
    ;;
  verify-rlds)
    cd "${project_root}"
    exec env CUDA_VISIBLE_DEVICES='' TF_CPP_MIN_LOG_LEVEL=3 MPLCONFIGDIR="${project_root}/.runtime/matplotlib" \
      HF_HOME="${project_root}/.runtime/huggingface-rlds" \
      TRANSFORMERS_CACHE="${project_root}/.runtime/huggingface-rlds/transformers" \
      ROBOT_PLATFORM=PIPER PIPER_ACTION_CHUNK="${PIPER_ACTION_CHUNK:-50}" \
      "$(runtime_python)" scripts/verify_rlds_dataset.py \
      --config "${rlds_config}" "$@"
    ;;
  train-lora)
    exec "${project_root}/scripts/train_openvla_lora.sh" \
      --config "${training_config}" "$@"
    ;;
  show-config)
    cd "${project_root}"
    exec "$(runtime_python)" \
      -m openvla_pipeline show-config --config "${runtime_config}" "$@"
    ;;
  plan)
    cd "${project_root}"
    exec env DRY_RUN=1 "${project_root}/tools/run_piper_openvla_runtime.sh" sync "$@"
    ;;
  model-server)
    exec "${project_root}/tools/run_piper_openvla_server.sh" "$@"
    ;;
  probe)
    cd "${project_root}"
    exec "$(runtime_python)" scripts/probe_fastapi_inference.py "$@"
    ;;
  dry-run)
    exec "${project_root}/tools/run_piper_openvla_runtime.sh" sync "$@" --mode dry-run
    ;;
  run-robot)
    exec "${project_root}/tools/run_piper_openvla_runtime.sh" sync "$@" --mode live
    ;;
  smoke)
    cd "${project_root}"
    test_python="$(runtime_python)"
    env CUDA_VISIBLE_DEVICES='' PYTHONDONTWRITEBYTECODE=1 \
      "${test_python}" tests/cpu_only_smoke.py
    env CUDA_VISIBLE_DEVICES='' PYTHONDONTWRITEBYTECODE=1 \
      "${test_python}" tests/rlds_converter_smoke.py
    env CUDA_VISIBLE_DEVICES='' PYTHONDONTWRITEBYTECODE=1 \
      "${test_python}" tests/yaml_config_smoke.py
    exec env CUDA_VISIBLE_DEVICES='' PYTHONDONTWRITEBYTECODE=1 \
      "${test_python}" tests/fastapi_server_smoke.py
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'error=unknown_command value=%q\n' "${command}" >&2
    usage >&2
    exit 2
    ;;
esac
