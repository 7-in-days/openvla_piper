+    if source_schema_path is not None:
+        with Path(source_schema_path).expanduser().open("r", encoding="utf-8") as stream:
+            source_schema = json.load(stream)
+        canonical_schema = json.dumps(source_schema, sort_keys=True, separators=(",", ":")).encode("utf-8")
+        contract["source_schema_sha256"] = hashlib.sha256(canonical_schema).hexdigest()
+        source_hz = source_schema.get("fps")
+        if control_hz is not None and source_hz is not None and not math.isclose(float(source_hz), control_hz):
+            raise ValueError(f"source schema fps mismatch: source={source_hz}, cfg={control_hz}")
+        if robot_contract is not None:
+            features = source_schema.get("features", {})
+            source_action_names = features.get("action", {}).get("names")
+            source_state_names = features.get("observation.state", {}).get("names")
+            if source_action_names != robot_contract["action_names"]:
+                raise ValueError("source action names do not match robot contract")
+            if source_state_names != robot_contract["state_names"]:
+                raise ValueError("source state names do not match robot contract")
