+
+
+def validate_training_contract(cfg, metadata: dict[str, Any]) -> None:
+    """Reject resumes that would silently change optimizer or model semantics."""
+    saved_contract = metadata.get("training_contract")
+    current_contract = build_training_contract(cfg)
+    if saved_contract != current_contract:
+        saved_contract = saved_contract or {}
+        mismatches = {
+            key: {"checkpoint": saved_contract.get(key), "current": current_contract.get(key)}
+            for key in sorted(set(saved_contract) | set(current_contract))
+            if saved_contract.get(key) != current_contract.get(key)
+        }
+        raise ValueError(f"Resume training contract mismatch: {mismatches}")
+
+
+def capture_rng_state() -> dict[str, Any]:
+    """Capture Python, NumPy, and PyTorch RNG state for best-effort continuation."""
+    return {
+        "python": random.getstate(),
+        "numpy": np.random.get_state(),
+        "torch_cpu": torch.get_rng_state(),
+        "torch_cuda": torch.cuda.get_rng_state_all(),
+    }
+
+
+def restore_rng_state(rng_state: dict[str, Any]) -> None:
+    """Restore RNG state saved by capture_rng_state()."""
+    random.setstate(rng_state["python"])
+    np.random.set_state(rng_state["numpy"])
+    torch.set_rng_state(rng_state["torch_cpu"])
+    torch.cuda.set_rng_state_all(rng_state["torch_cuda"])
+
