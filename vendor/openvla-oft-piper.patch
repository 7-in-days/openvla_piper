+def _fsync_directory(path: Path) -> None:
+    """Flush a directory entry after an atomic rename."""
+    directory_fd = os.open(path, os.O_RDONLY)
+    try:
+        os.fsync(directory_fd)
+    finally:
+        os.close(directory_fd)
+
+
+def _fsync_tree(path: Path) -> None:
+    """Flush every checkpoint file before publishing its directory."""
+    directories = [path]
+    for child in path.rglob("*"):
+        if child.is_file():
+            with child.open("rb") as stream:
+                os.fsync(stream.fileno())
+        elif child.is_dir():
+            directories.append(child)
+    for directory in reversed(directories):
+        _fsync_directory(directory)
+
+
+def atomic_write_json(path: Path, payload: dict[str, Any]) -> None:
+    """Write JSON through a temporary sibling and atomically replace the destination."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary_path = path.with_name(f".{path.name}.tmp-{os.getpid()}-{uuid.uuid4().hex}")
+    try:
+        with temporary_path.open("w", encoding="utf-8") as stream:
+            json.dump(payload, stream, indent=2, sort_keys=True)
+            stream.write("\n")
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary_path, path)
+        _fsync_directory(path.parent)
+    finally:
+        temporary_path.unlink(missing_ok=True)
+
