+def get_optimizer_update_step(
+    batch_idx: int,
+    grad_accumulation_steps: int,
+    initial_step: int = 0,
+) -> Optional[int]:
+    """Return the 1-based completed optimizer step at an accumulation boundary."""
+    if batch_idx < 0:
+        raise ValueError("batch_idx must be non-negative")
+    if grad_accumulation_steps < 1:
+        raise ValueError("grad_accumulation_steps must be positive")
+    if initial_step < 0:
+        raise ValueError("initial_step must be non-negative")
+
+    completed_micro_batches = batch_idx + 1
+    if completed_micro_batches % grad_accumulation_steps != 0:
+        return None
+    return initial_step + completed_micro_batches // grad_accumulation_steps
+
+
+def should_save_checkpoint(update_step: int, save_freq: int, max_steps: int) -> bool:
+    """Save periodic checkpoints and always commit the requested final optimizer step."""
+    if update_step < 1:
+        raise ValueError("update_step must be positive")
+    if save_freq < 1:
+        raise ValueError("save_freq must be positive")
+    if max_steps < 1:
+        raise ValueError("max_steps must be positive")
+    return update_step % save_freq == 0 or update_step >= max_steps
