+    if (path / CHECKPOINT_METADATA_FILENAME).is_file() and (path / TRAINER_STATE_FILENAME).is_file():
+        checkpoint_dir = path
+    elif requested_step is not None and (path / ATOMIC_CHECKPOINTS_DIRNAME).is_dir():
+        checkpoint_dir = get_checkpoint_step_dir(path, requested_step)
+    else:
